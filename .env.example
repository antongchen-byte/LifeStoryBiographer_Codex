# Generate .env with python3 scripts/setup.py. Never commit the generated file.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
DATABASE_URL=postgresql+psycopg://biographer:biographer@postgres:5432/biographer
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=biographer
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_TASK_QUEUE=biographer-media
UPLOAD_MAX_BYTES=2147483648
# Optional local ClamAV: set SCANNER=clamav and use docker compose --profile scan up --build
SCANNER=disabled

# Server-side Style Lab and Interview Studio Gemini access.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional voice replies; requires access to this separate audio-generation model.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Blank: use the same PostgreSQL server/credentials, database biographer_interviews.
# A custom URL must point to an already-created database.
INTERVIEW_DATABASE_URL=
